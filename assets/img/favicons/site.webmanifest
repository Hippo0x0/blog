---
layout: compress
---
{% assign favicon_path = "/assets/img/favicons" | relative_url %}
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.title | jsonify }},
  "description": {{ site.description | jsonify }},
  "icons": [
    {"src": "{{ favicon_path }}/web-app-manifest-192x192.png?v=20261125-cat", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "{{ favicon_path }}/web-app-manifest-512x512.png?v=20261125-cat", "sizes": "512x512", "type": "image/png", "purpose": "any"}
  ],
  "start_url": "{{ '/index.html' | relative_url }}",
  "theme_color": "#fff4df",
  "background_color": "#fff4df",
  "display": "standalone"
}
